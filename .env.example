# ==========================================
# AI-Powered Event Photo Finder - Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AI Event Photo Finder"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=photofinder

# Optional direct database connection string
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photofinder

# Supabase Auth (Google OAuth). Used by the backend to verify the Supabase session.
# Frontend values live in frontend/.env.local (see frontend/.env.example).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
FRONTEND_URL=http://localhost:3000

# Frontend Client
NEXT_PUBLIC_API_URL=http://localhost:8000
