# ==========================================
# AI-Powered Event Photo Finder - Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AI Event Photo Finder"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=photofinder

# Optional direct database connection string
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photofinder

# Frontend Client
NEXT_PUBLIC_API_URL=http://localhost:8000
